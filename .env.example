# ========================================================
# CarbonCalculator Environment Configuration Template
# Copy this file to .env and configure for your environment
# NEVER commit production secrets or .env to version control
# ========================================================

# --- Backend Server Configuration ---
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random string in production)
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars

# Default System Administrator Account
ADMIN_EMAIL=admin@vastenergycell.in
ADMIN_PASSWORD=vastEnergyCell@2026

# Optional: Google OAuth Client ID (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Database Path (defaults to ./carboncalculator.db inside server directory)
DATABASE_PATH=./carboncalculator.db

# Gemini AI Vision API Key (Optional: for AI challenge photo proof verification; falls back to manual coordinator review if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend Client Configuration ---
# Leave as /api if served together as a unified service
# Or provide your deployed backend URL: https://your-backend.onrender.com/api
VITE_API_BASE=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
